# Required — copy the values from your local .env.local or Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required for the protected daily Supabase keep-alive task on Vercel.
# Use a random value with at least 16 characters and never commit the real value.
CRON_SECRET=replace-with-a-random-string-at-least-16-characters-long

# Optional — enables the 100 requests/minute rate limit.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Official production URL used for metadata and sharing links.
NEXT_PUBLIC_APP_URL=https://iqpr-time.vercel.app
